generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Video {
  id             String   @id @default(cuid())
  title          String
  description    String?
  publicId       String
  originalSize   Int
  compressedSize Int
  duration       Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}